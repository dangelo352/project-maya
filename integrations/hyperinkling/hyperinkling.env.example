# Copy to /root/HyperInkling/.env after checking paths. Do not commit the private .env.
MODEL=/root/HyperInkling/models/Inkling-2-Mini-Uncensored-W4A16-g128-gptq
SERVED_NAME=inkling-2-mini
HOST=127.0.0.1
PORT=18023
DASHBOARD=0
MAX_LEN=auto
MAX_SEQS=8
GPU_UTIL=0.95
KEEP_FREE_GB=2
KV_DTYPE=fp8
KV_OFFLOAD_GB=auto
SPEC=dflash2
DFLASH2_MODEL=/root/HyperInkling/models/Inkling-2-Mini-DFlash2
ASYNC=1
NBT=2048
# vLLM's high practical ceiling; the model's context window limits usable image tokens.
IMAGES=999
WARMUP=1
EXTRA_ARGS=--enable-sleep-mode
