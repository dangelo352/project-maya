{
  "name": "@maya/dsh-backend-gate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./recovery": "./lib/recovery.js",
    "./memory-controls": "./lib/memory-controls.js",
    "./memory-controls-v2": "./lib/memory-controls-v2.js",
    "./memory-controls-v3": "./lib/memory-controls-v3.js",
    "./memory-controls-v4": "./lib/memory-controls-v4.js",
    "./memory-controls-v5": "./lib/memory-controls-v5.js"
  },
  "scripts": {
    "bundle:client": "node ./scripts/bundle-client.mjs",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5"
  }
}
