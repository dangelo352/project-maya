{
  "exe": "build/windows-cuda-ik2-release/maya-ik2.exe",
  "args": [
    "--model", "models/Inkling-2-Mini-UD-Q4_K_XL.gguf",
    "--max-context", "200704",
    "--chunk", "512",
    "--draft", "models/mtp.safetensors"
  ],
  "env": {
    "IK2_KV": "fp8",
    "IK2_GATE_TILE": "64",
    "IK2_GATE_BF16": "1",
    "IK2_Q8_UNROLL": "1",
    "IK2_BATCH_PREFILL": "1",
    "IK2_DRAFT_CTX": "8192",
    "IK2_DRAFT_WIDTH": "8"
  },
  "tokenizer": "ik2/tokenizer",
  "model_name": "inkling-2-mini",
  "vision": {
    "exe": "build/windows-vision-release/bin/maya-vision.exe",
    "mmproj": "models/mmproj-BF16.gguf",
    "model": "models/Inkling-2-Mini-UD-Q4_K_XL.gguf",
    "gpu": false,
    "resident": true
  }
}
